EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api
# Physical device: use your computer LAN IP, e.g. http://192.168.x.x:8000/api
# Android emulator: http://10.0.2.2:8000/api

# LocationIQ API key for farm location autocomplete (never commit real keys)
EXPO_PUBLIC_LOCATIONIQ_KEY=

# Optional: Google Maps SDK key for native MapView (also set in EAS secrets for builds)
# GOOGLE_MAPS_API_KEY=
